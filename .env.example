# GEMINI_API_KEY: Primary AI provider. Required.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: Optional override (default: gemini-3.5-flash). Used for course generation and
# the other authoring tools. Do NOT set a 2.x model here: the whole 2.x line, including
# gemini-2.0-flash and gemini-2.5-flash-lite, is closed to new API keys and returns 404
# NOT_FOUND rather than falling back to anything.
GEMINI_MODEL=gemini-3.5-flash

# GEMINI_TUTOR_API_KEY: REQUIRED for the student-facing lesson tutor (/api/lesson-tutor).
# Must be a key from a DIFFERENT Google project than GEMINI_API_KEY, so student traffic has
# its own quota and one busy cohort cannot take course generation down with it. Without this
# the route returns 503 and the tutor is simply off -- it deliberately does NOT fall back to
# the platform key. It also never falls back to OpenAI, so an exhausted free tier surfaces as
# an error instead of quietly spending paid credit.
GEMINI_TUTOR_API_KEY="MY_TUTOR_GEMINI_API_KEY"
# GEMINI_TUTOR_MODEL: Model for the tutor only (default: GEMINI_MODEL). The lite tier is the
# right fit here -- tutor answers are short explanations of text already supplied in the
# prompt, which is the cheapest thing a model can be asked to do, and it is the highest-volume
# AI surface on the platform. Being a 3.x model, it also gets the "low" thinking cap, which
# the version gate omits on older models because they reject the parameter outright.
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite

# Tutor rate limits. The per-user cap stops one student monopolising the tutor; the global caps
# protect the Gemini PROJECT quota, which is what Google actually meters -- a per-user limit
# does nothing there, since many students each within their own allowance can still drain a
# shared daily allocation between them. Tune to the plan the tutor key sits on.
# TUTOR_USER_HOURLY_LIMIT=15
# TUTOR_GLOBAL_HOURLY_LIMIT=120
# TUTOR_GLOBAL_DAILY_LIMIT=600

# OPENAI_API_KEY: Fallback AI provider. Used automatically if Gemini fails.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OPENAI_MODEL: Optional override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# YOUTUBE_API_KEY: Optional, but recommended for AI lesson video suggestions.
# Used by the course lesson generator to find embeddable YouTube videos.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# SUPABASE AUTH -- DASHBOARD SETTINGS, NOT ENV VARS
#
# These live in the Supabase project, not in this file, and nothing in the repo can check them.
# A new tenant that skips them looks fine until real people try to sign up.
#
# 1. Authentication > Providers > Email: enable 'Confirm email'. Without it signUp returns a
#    session immediately and an account activates with no address ever proved.
#
# 2. Authentication > URL Configuration > Redirect URLs -- list ALL of these per environment.
#    Supabase matches exactly and silently discards anything unlisted, falling back to the Site
#    URL, which lands the student on the wrong page:
#      https://<host>/auth/confirm     -- signup confirmation and setup links (canonical)
#      https://<host>/auth/callback    -- legacy PKCE confirmation, still in old inboxes
#      https://<host>/auth/recover     -- password recovery
#
# 3. Authentication > Email Templates > 'Confirm signup': point the link at the DURABLE path
#      {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup
#    NOT the default {{ .ConfirmationURL }}, which is a PKCE link: it only works in the browser
#    the signup started in, so a student who signs up on a laptop and opens the email on a phone
#    gets 'invalid or expired link' with nothing expired. Mail scanners consume it too.
#
# 4. Authentication > SMTP Settings: configure a real provider. The built-in sender is rate
#    limited to a handful of messages per hour and is not for production -- public signups hit
#    that ceiling immediately and confirmation emails simply stop arriving, with no error.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security / server-side tokens
# TOKEN_ENCRYPTION_KEY must be a base64-encoded 32-byte key.
TOKEN_ENCRYPTION_KEY=
COURSE_PYTHON_PROOF_SECRET=
CRON_SECRET=
REINDEX_SECRET=
INTAKE_WEBHOOK_SECRET=

# Resend -- transactional email + audience management (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: Resend Audience ID. When set, new signups are added as contacts automatically.
RESEND_AUDIENCE_ID=

# Upstash Redis / Vector / QStash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Cloudinary — sign up at cloudinary.com, get credentials from Dashboard > Settings > API Keys
# CLOUDINARY_CLOUD_NAME is also exposed to the browser (via next.config.ts) so covers stored as
# bare public_ids resolve client-side. The cloud name is non-secret; the key/secret stay server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated HTTPS hosts allowed as landing-page social thumbnail sources.
OG_IMAGE_ALLOWED_HOSTS=res.cloudinary.com

# GitHub uploads: used for assignment resources and virtual experience datasets/files.
# The repository must be public when the app stores raw.githubusercontent.com URLs.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_BRANCH=main

# Bunny video library
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=

# Optional search/image providers
PEXELS_API_KEY=
NEXT_PUBLIC_PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_API_KEY=

# Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A:F

# Platform sync
NEXT_PUBLIC_SYNC_ENABLED=false
PLATFORM_SYNC_URL=
PLATFORM_SYNC_KEY=
PLATFORM_SYNC_OWNER_ID=

# Cron tuning
DEADLINE_REMINDER_DAYS=3
NUDGE_INACTIVITY_DAYS=7
NUDGE_RESEND_AFTER_DAYS=14

# Public branding / tenant defaults
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_LOGO_DARK_URL=
NEXT_PUBLIC_TEAM_NAME=
NEXT_PUBLIC_SENDER_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BRAND_COLOR=#2563eb
NEXT_PUBLIC_PRIMARY_COLOR=#2563eb
NEXT_PUBLIC_ACCENT_COLOR=#f59e0b
NEXT_PUBLIC_EMAIL_BANNER_URL=
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
# Public Brandfetch client ID used by Brand Search and Logo API (not a secret API key)
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
NEXT_PUBLIC_HERO_TITLE=
NEXT_PUBLIC_HERO_TITLE_ACCENT=
NEXT_PUBLIC_HERO_SUBHEADLINE=
NEXT_PUBLIC_HERO_PRIMARY_CTA=Get started
NEXT_PUBLIC_FOOTER_TAGLINE=
NEXT_PUBLIC_STATS_ENROLLED=
NEXT_PUBLIC_STATS_RATING=

# Local development
DISABLE_HMR=

# Sentry -- error tracking (sentry.io)
# Every variable here is optional. With NEXT_PUBLIC_SENTRY_DSN unset the SDK
# initialises disabled and sends nothing, which is what local development gets, so
# nothing below needs to be filled in to run the app.
#
# NEXT_PUBLIC_SENTRY_DSN: the project DSN. Public by design (it only permits writes),
# and it must be per tenant -- one DSN shared across deployments mixes every tenant's
# errors into one project. Middleware reads this to allow the report host through the
# app CSP, so a DSN set only at build time and not at runtime means reports are sent
# and then blocked by the browser.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT: optional label. Defaults to a build-time copy of
# VERCEL_ENV (see SENTRY_DEPLOY_ENV in next.config.ts), which already separates
# production from preview on both the server and the client, so this is only needed
# when deploying somewhere other than Vercel.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: performance tracing, 0 to 1. Left at 0
# because transactions are metered separately from errors and sampling every request
# spends the quota that error reports need. Set 0.1 temporarily when chasing latency.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: build-time only, for uploading
# source maps. Without them the app still reports errors, but production stack traces
# point at minified chunk names instead of real files. The auth token is a SECRET --
# set it in CI and in the host's environment, never in a committed file.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
